{
  "name": "resumematch-ai",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://deshemaru.github.io,http://localhost:8080",
    "GEMINI_MODEL": "gemini-3.1-flash-lite"
  },
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 2, "period": 60 }
  }],
  "observability": { "enabled": false }
}
